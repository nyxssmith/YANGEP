{
  "type": "object",
  "properties": {
    "state_machines": {
      "type": "array",
      "description": "The state machines available to this entity, specified by name or inline definition.",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "states": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "inputs": { "type": "object" }
                  },
                  "required": ["name"]
                }
              }
            },
            "required": ["name", "states"]
          }
        ]
      }
    },
    "default_state_machine": {
      "type": "string",
      "description": "The name of the state machine this entity starts with."
    }
  },
  "required": ["state_machines", "default_state_machine"]
}
